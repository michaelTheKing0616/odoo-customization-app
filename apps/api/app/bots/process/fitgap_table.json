  "gaps": [
    {
      "id": "weighbridge",
      "label": "Weighbridge gross/tare capture",
      "patterns": [
        "weigh ?bridge",
        "gross",
        "tare"
      ],
      "reason": "Stock Odoo has no truck gross/tare/net weighing ticket on receipts.",
      "model": "ingenium.weighbridge.ticket",
      "depends": [
        "stock"
      ],
      "fields": [
        {
          "name": "picking_id",
          "ttype": "many2one",
          "relation": "stock.picking",
          "string": "Receipt",
          "required": true
        },
        {
          "name": "vehicle",
          "ttype": "char",
          "string": "Vehicle"
        },
        {
          "name": "gross_kg",
          "ttype": "float",
          "string": "Gross (kg)",
          "required": true
        },
        {
          "name": "tare_kg",
          "ttype": "float",
          "string": "Tare (kg)",
          "required": true
        },
        {
          "name": "net_kg",
          "ttype": "float",
          "string": "Net (kg)",
          "readonly": true
