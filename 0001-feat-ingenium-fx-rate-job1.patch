+                </setting>
+            </xpath>
+        </field>
+    </record>
+</odoo>
+'''
+    cron_xml = '''<?xml version="1.0" encoding="utf-8"?>
+<odoo>
+    <record forcecreate="True" id="ir_cron_fx_currency_rates" model="ir.cron">
+        <field name="name">ingenium: update FX currency rates</field>
