+    </record>
+</odoo>
+'''
+    return [
+        {
+            "source_file": "models/fx_rates.py",
+            "kind": "python",
+            "reason": f"{CLASS_MARKER}: generic provider → {RATE_MODEL}",
+            "content": py,
