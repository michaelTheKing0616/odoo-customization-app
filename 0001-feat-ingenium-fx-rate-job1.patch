+                            <field name="x_fx_provider_url"/>
+                        </div>
+                        <div class="row mt8">
+                            <label for="x_fx_interval_unit" class="col-lg-3 o_light_label"/>
+                            <field name="x_fx_interval_unit"/>
+                        </div>
