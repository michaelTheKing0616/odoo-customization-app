# Odoo Customization App — environment template (copy to apps/api/.env or export)
# Never commit real secrets. Generate FERNET_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# App metadata Postgres (separate from customer Odoo DBs)
DATABASE_URL=postgresql+psycopg://odoo_custom:odoo_custom@127.0.0.1:5433/odoo_custom

# Credential encryption at rest. Local/CI may use a key starting with "dev-only-"
# (deterministic fallback). Production MUST use a real Fernet.generate_key() value.
FERNET_KEY=dev-only-replace-me-use-Fernet-generate_key()

# App API auth: off | api_key
AUTH_MODE=off
# Required when AUTH_MODE=api_key (Bearer or X-API-Key). Prefer hashed keys via /api/auth.
APP_API_KEY=

# Mutating requests per client IP per minute (0 = disabled)
RATE_LIMIT_PER_MINUTE=120

# Persist mutating request audit rows (true/false)
AUDIT_LOG_ENABLED=true
# Delete audit rows older than N days via POST /api/audit/purge (0 = never)
AUDIT_RETENTION_DAYS=90

# When behind a reverse proxy, set true so client IP comes from X-Forwarded-For
# (only enable if the proxy strips untrusted forwarded headers)
TRUSTED_PROXY=false

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

# Local Odoo gate defaults (never commit customer credentials)
ODOO_URL=http://127.0.0.1:8069
ODOO_DB=odoo_dev
ODOO_USER=admin
ODOO_PASSWORD=admin

# Sandbox preload (comma-separated). Empty = fast smoke.
# Extension gates use: SANDBOX_EXTRA_MODULES=sale,account
# Library gate uses: SANDBOX_EXTRA_MODULES=contacts,mail
SANDBOX_EXTRA_MODULES=

# Optional NL → ModuleSpec (never auto-applies). Job Autopilot planner uses a
# frontier provider when AI_ASSIST=auto; install/config/apply stay RPC, not LLM.
# off | auto | ollama | openai | claude | gemini | openai-compatible
# off | auto | ollama | openai | claude | gemini | openai-compatible
# auto = first configured cloud key (Anthropic → OpenAI → Gemini). Does not fall back to Ollama.
AI_ASSIST=off
# Cloud keys — set one of these + AI_ASSIST=auto (or openai|claude|gemini). Never commit real keys.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # accepted as an alias for GEMINI_API_KEY
# GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Deploy API container cannot use 127.0.0.1 (container loopback). Override when starting
# docker/docker-compose.deploy.yml: OLLAMA_BASE_URL=http://host.docker.internal:11434
# Qwen3 ladder (Apple Silicon): ollama pull qwen3:8b
# 16GB unified: keep 8b as the Ollama daily driver. 14b times out. 30b-a3b (~18GB) needs ~32GB RAM.
# Optional: ollama pull qwen3:30b-a3b  then set the three names below when you have the RAM.
OLLAMA_MODEL=qwen3:8b
# Cloud providers ignore Ollama-shaped names here (qwen3:8b). Override with OPENAI_MODEL / ANTHROPIC_MODEL / GEMINI_MODEL.
AI_MODEL_BULK=qwen3:8b
# Match bulk on solo Macs — set qwen3:14b only if you accept slower drafts / timeouts
AI_MODEL_REASONING=qwen3:8b
# Gemini Flash (free-tier typical). AI_ASSIST=gemini|auto + GEMINI_API_KEY.
# HTTP 429 waits Retry-After (capped), then tries another configured cloud key or local Ollama.
# auto does not *select* Ollama when a cloud key exists — 429 fallback is separate.
# Ollama fallback always POSTs OLLAMA_MODEL (qwen3:8b), never AI_MODEL_BULK when that is gemini-/gpt-/claude-.
# GEMINI_MODEL=gemini-2.5-flash
# When Gemini is on, also set:
# AI_ASSIST=gemini
# AI_MODEL_BULK=gemini-2.5-flash
# AI_MODEL_REASONING=gemini-2.5-flash
AI_THINKING=auto
# OpenAI-compatible (vLLM / LM Studio / xAI Grok) when AI_ASSIST=openai-compatible
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_API_KEY=
# xAI Grok (paid API — no permanent free tier; optional data-sharing credits in console):
#   AI_ASSIST=openai-compatible
#   OPENAI_COMPATIBLE_BASE_URL=https://api.x.ai/v1
#   OPENAI_COMPATIBLE_MODEL=grok-4.3
#   OPENAI_COMPATIBLE_API_KEY=<from https://console.x.ai>
# Bulk/reasoning aliases still apply when set (e.g. grok-4.3 for both, or grok-build-0.1 for reasoning).
# single = one JSON call + pack merge; staged = Step 0–6 pipeline (ELITE-1 default)
AI_PIPELINE_MODE=staged
# ELITE_SCORECARD_FLOOR=9.0
# AI_GENERATION_CLOUD_PREFERRED=false
# Domain pack RAG (MiniLM). auto|on|off — install: uv sync --project apps/api --extra ai-rag
AI_RAG=auto
AI_RAG_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_RAG_MIN_SCORE=0.35
# Jaccard fallback threshold when sentence-transformers unavailable (lower than embedding bar)
AI_RAG_MIN_SCORE_JACCARD=0.12

# Expert RAG — optional extra community dir (built-in docs/expert/community/ always ingested)
# EXPERT_COMMUNITY_SOURCE=dir
# EXPERT_COMMUNITY_DIR=/path/to/more/qa-markdown
# Expert RAG — odoo/odoo source (res.country.state + l10n manifests): on | off
EXPERT_ODOO_SOURCE=on
# Expert ask — per Ollama/OpenAI-compatible call (qwen3:8b often needs >120s). Restart API after change.
# EXPERT_LLM_TIMEOUT_S=300
# Next /api proxy budget for expert/* + module-spec apply/export + elite-autopilot (ms). Default 660000 ≈ 2× LLM timeout + RPC headroom.
# EXPERT_UPSTREAM_TIMEOUT_MS=660000
# Self-critique after draft (LLM when available). auto|on|off
AI_CRITIQUE=auto
# UAT hop debug — write exact final LLM system+user prompts to .cache/ai_llm_prompts/
# AI_LOG_LLM_PROMPTS=1
# Apply-readiness + production-shape passes run automatically after enrich / reuse merge
# (align selection domains, branch dedup, inventory reason wiring — no env flag).

# Designer live preview: Open-in-Odoo uses connection.url + #model=… only (no password).
# Embedded iframe often blocked by Odoo X-Frame-Options; prefer popup + Refresh preview.
# Same-origin reverse proxy is optional future work — not required for v1.

# DB_MIGRATIONS=off | auto — auto runs alembic upgrade head on API startup (deploy)
DB_MIGRATIONS=off

# Conversational refinement — LLM tiers (fast=generate/clarify, refine=chat patches)
# AI_LLM_TIER_FAST=gemini
# AI_LLM_TIER_REFINE=gemini
# AI_REFINE_MODEL=   # optional override when tier refine is gemini
# Optional LLM intent tie-break when pack/residual is ambiguous (auto|on|off). Never overrides hard pack_conflict.
# AI_INTENT_LLM=auto

# Accounts auth (AUTH_MODE=accounts) — OAuth off by default
# OAUTH_PROVIDERS=google,github
# OAUTH_REDIRECT_BASE=http://127.0.0.1:3000
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# Leave empty to disable sandbox runs (default in docker-compose.deploy.yml).
# When set, mount the host socket into the API container — see DEPLOY.md security note.
SANDBOX_DOCKER_SOCKET=

# Universal Ingest vision OCR — off | ollama (requires: ollama pull qwen3-vl:8b)
INGEST_VISION=off
INGEST_VISION_MODEL=qwen3-vl:8b

# Job Autopilot connectors (optional). Do NOT reuse PAYSTACK_SECRET_KEY (that's app billing).
# Autopilot never writes these into the job packet or ir.config_parameter.
# AUTOPILOT_PAYMENT_SECRET=
# AUTOPILOT_WEBHOOK_TOKEN=


# Live Demo Co-Pilot — Attendee (self-host http://127.0.0.1:8000 or https://app.attendee.dev)
ATTENDEE_API_BASE=http://127.0.0.1:8000
ATTENDEE_API_KEY=
# Base64 webhook secret from Attendee Settings → Webhooks
ATTENDEE_WEBHOOK_SECRET=
# true = allow mock bot launch for UI/consent tests without Attendee keys
ATTENDEE_ALLOW_MOCK=false
APP_ENVIRONMENT=development
ATTENDEE_WEBHOOK_MAX_SKEW_S=300
