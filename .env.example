# Odoo Customization App — environment template (copy to apps/api/.env or export)
# Never commit real secrets. Generate FERNET_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# App metadata Postgres (separate from customer Odoo DBs)
DATABASE_URL=postgresql+psycopg://odoo_custom:odoo_custom@127.0.0.1:5433/odoo_custom

# Credential encryption at rest. Local/CI may use a key starting with "dev-only-"
# (deterministic fallback). Production MUST use a real Fernet.generate_key() value.
FERNET_KEY=dev-only-replace-me-use-Fernet-generate_key()

# App API auth: off | api_key
AUTH_MODE=off
# Required when AUTH_MODE=api_key (Bearer or X-API-Key). Prefer hashed keys via /api/auth.
APP_API_KEY=

# Mutating requests per client IP per minute (0 = disabled)
RATE_LIMIT_PER_MINUTE=120

# Persist mutating request audit rows (true/false)
AUDIT_LOG_ENABLED=true
# Delete audit rows older than N days via POST /api/audit/purge (0 = never)
AUDIT_RETENTION_DAYS=90

# When behind a reverse proxy, set true so client IP comes from X-Forwarded-For
# (only enable if the proxy strips untrusted forwarded headers)
TRUSTED_PROXY=false

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local Odoo gate defaults (never commit customer credentials)
ODOO_URL=http://127.0.0.1:8069
ODOO_DB=odoo_dev
ODOO_USER=admin
ODOO_PASSWORD=admin

# Sandbox preload (comma-separated). Empty = fast smoke.
# Extension gates use: SANDBOX_EXTRA_MODULES=sale,account
# Library gate uses: SANDBOX_EXTRA_MODULES=contacts,mail
SANDBOX_EXTRA_MODULES=

# Optional NL → ModuleSpec (never auto-applies).
# off | ollama | openai-compatible
AI_ASSIST=off
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Apple Silicon sweet spot: ollama pull qwen2.5:7b-instruct-q4_K_M
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
# OpenAI-compatible (vLLM / LM Studio / OpenAI) when AI_ASSIST=openai-compatible
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_API_KEY=
# single = one JSON call + pack merge; staged = Step 0–6 pipeline
AI_PIPELINE_MODE=single
# Domain pack RAG (MiniLM). auto|on|off — install: uv sync --project apps/api --extra ai-rag
AI_RAG=auto
AI_RAG_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_RAG_MIN_SCORE=0.35
# Self-critique after draft (LLM when available). auto|on|off
AI_CRITIQUE=auto

# Designer live preview: Open-in-Odoo uses connection.url + #model=… only (no password).
# Embedded iframe often blocked by Odoo X-Frame-Options; prefer popup + Refresh preview.
# Same-origin reverse proxy is optional future work — not required for v1.

# DB_MIGRATIONS=off | auto — auto runs alembic upgrade head on API startup (deploy)
DB_MIGRATIONS=off

# Accounts auth (AUTH_MODE=accounts) — OAuth off by default
# OAUTH_PROVIDERS=google,github
# OAUTH_REDIRECT_BASE=http://127.0.0.1:3000
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# Leave empty to disable sandbox runs (default in docker-compose.deploy.yml).
# When set, mount the host socket into the API container — see DEPLOY.md security note.
SANDBOX_DOCKER_SOCKET=
