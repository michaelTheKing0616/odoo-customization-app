# -*- coding: utf-8 -*-
{
    "name": "{{ spec.display_name | e }}",
    "version": "{{ spec.version | e }}",
    "category": "Customization",
    "summary": "Generated by Odoo Custom",
    "depends": [{% for d in spec.depends %}"{{ d }}"{% if not loop.last %}, {% endif %}{% endfor %}],
    "data": [
{% for f in data_files %}
        "{{ f }}",
{% endfor %}
    ],
    "installable": True,
    "application": {{ 'True' if application else 'False' }},
    "license": "LGPL-3",
    "author": "{{ spec.author | e }}",
{% if spec.include_barcode_scan_widget %}
    "assets": {
        "web.assets_backend": [
            "{{ spec.technical_name }}/static/src/js/x_barcode_scan_field.js",
            "{{ spec.technical_name }}/static/src/xml/x_barcode_scan_field.xml",
        ],
    },
{% endif %}
}
