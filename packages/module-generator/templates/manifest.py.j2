# -*- coding: utf-8 -*-
{
    "name": {{ spec.display_name | pystr }},
    "version": {{ spec.version | pystr }},
    "category": "Customization",
    "summary": "Generated by Odoo Custom",
    "depends": [{% for d in spec.depends %}{{ d | pystr }}{% if not loop.last %}, {% endif %}{% endfor %}],
    "data": [
{% for f in data_files %}
        {{ f | pystr }},
{% endfor %}
    ],
    "installable": True,
    "application": {{ 'True' if application else 'False' }},
    "license": "LGPL-3",
    "author": {{ spec.author | pystr }},
{% if spec.include_barcode_scan_widget %}
    "assets": {
        "web.assets_backend": [
            "{{ spec.technical_name }}/static/lib/zxing-browser.min.js",
            "{{ spec.technical_name }}/static/src/js/x_barcode_scan_field.js",
            "{{ spec.technical_name }}/static/src/xml/x_barcode_scan_field.xml",
        ],
    },
{% endif %}
}
