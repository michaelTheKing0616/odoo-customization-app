<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
{% for report in spec.reports %}
    <template id="{{ report.template_xml_id }}">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page ing-proof">
                    <!-- Touch 130: print-grade proofs. No widows or orphans, hyphenation, hanging punctuation where the
                         renderer supports it, and money columns that line up on the decimal (tabular figures, right-aligned). -->
                    <style>
                        .ing-proof p, .ing-proof li { orphans: 3; widows: 3; -webkit-hyphens: auto; hyphens: auto; hanging-punctuation: first last; }
                        .ing-proof h1, .ing-proof h2, .ing-proof h3, .ing-proof thead, .ing-proof tr { page-break-inside: avoid; break-inside: avoid; page-break-after: auto; }
                        .ing-proof h1, .ing-proof h2, .ing-proof h3 { page-break-after: avoid; break-after: avoid; }
                        .ing-proof .text-end, .ing-proof .text-right, .ing-proof .o_price_total, .ing-proof [class*="amount"], .ing-proof td.money { text-align: right; font-variant-numeric: tabular-nums lining-nums; font-feature-settings: "tnum" 1, "lnum" 1; white-space: nowrap; }
                    </style>
{% if report.t_lang %}
                    <t t-lang="{{ report.t_lang }}">
{{ report.body_html }}
                    </t>
{% else %}
{{ report.body_html }}
{% endif %}
                </div>
            </t>
        </t>
    </template>
    <record id="{{ report.action_xml_id() }}" model="ir.actions.report">
        <field name="name">{{ report.name | xml }}</field>
        <field name="model">{{ report.model | xml }}</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">{{ spec.technical_name }}.{{ report.template_xml_id }}</field>
        <field name="report_file">{{ spec.technical_name }}.{{ report.template_xml_id }}</field>
        <field name="binding_model_id" search="[('model','=','{{ report.model | xml }}')]"/>
        <field name="binding_type">report</field>
        {% if report.print_report_name %}
        <field name="print_report_name">{{ report.print_report_name | xml }}</field>
        {% endif %}
    </record>
{% endfor %}
</data>
</odoo>
