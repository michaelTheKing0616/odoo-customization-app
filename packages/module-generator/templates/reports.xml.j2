<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
{% for report in spec.reports %}
    <template id="{{ report.template_xml_id }}">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page">
{{ report.body_html }}
                </div>
            </t>
        </t>
    </template>
    <record id="{{ report.action_xml_id() }}" model="ir.actions.report">
        <field name="name">{{ report.name | xml }}</field>
        <field name="model">{{ report.model | xml }}</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">{{ spec.technical_name }}.{{ report.template_xml_id }}</field>
        <field name="report_file">{{ spec.technical_name }}.{{ report.template_xml_id }}</field>
        <field name="binding_model_id" search="[('model','=','{{ report.model | xml }}')]"/>
        <field name="binding_type">report</field>
        {% if report.print_report_name %}
        <field name="print_report_name">{{ report.print_report_name | xml }}</field>
        {% endif %}
    </record>
{% endfor %}
</data>
</odoo>
